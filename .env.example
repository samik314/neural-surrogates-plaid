# Optional. Without these, paths default to the repo root (src/plaid_surrogates/utils/paths.py):
#   PLAID_DATA_DIR -> <repo>/data, PLAID_RUNS_DIR -> <repo>/runs, HF_HOME -> <repo>/data/hf_cache
# Set them where the defaults don't fit (e.g. cluster scratch/project space). To use: copy to .env
# (gitignored); the job scripts in scripts/slurm/ load it. Expect about 2 GB for the data and caches
# and ~0.1 GB per run.

# PLAID_DATA_DIR=/scratch/<user>/plaid_work/data
# PLAID_RUNS_DIR=/scratch/<user>/plaid_work/runs
# HF_HOME=/scratch/<user>/plaid_work/data/hf_cache

# Optional: force a device (cuda | mps | cpu); default picks cuda -> mps -> cpu
# PLAID_DEVICE=cuda
